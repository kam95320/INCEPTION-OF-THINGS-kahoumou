LOGIN = "kahoumou"

Vagrant.configure("2") do |config|
config.vm.box = "bento/debian-12"
config.ssh.insert_key = false
config.vm.boot_timeout = 600
config.ssh.connect_timeout = 600
config.vm.define "#{LOGIN}S" do |server|
server.vm.hostname = "#{LOGIN}S"
server.vm.network "private_network", ip: "192.168.56.110"

server.vm.provider "virtualbox" do |vb|
    vb.name = "#{LOGIN}S"
    vb.memory = 2048
    vb.cpus = 1
    vb.customize ["modifyvm", :id, "--nestedpaging", "off"]
    vb.customize ["modifyvm", :id, "--paravirtprovider", "none"]

     end
       server.vm.provision "shell", path: "scripts/server.sh"
  end

config.vm.define "#{LOGIN}SW" do |worker|
worker.vm.hostname = "#{LOGIN}SW"
worker.vm.network "private_network", ip: "192.168.56.111"

worker.vm.provider "virtualbox" do |vb|
    vb.name = "#{LOGIN}SW"
    vb.memory = 2048
    vb.cpus = 1
    vb.customize ["modifyvm", :id, "--nestedpaging", "off"]
    vb.customize ["modifyvm", :id, "--paravirtprovider", "none"]
    end
      worker.vm.provision "shell", path: "scripts/agent.sh"
  end
end

